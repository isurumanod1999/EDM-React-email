{
  "name": "react-email-nextjs",
  "version": "1.0.0",
  "description": "Next.js app with React Email components",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify": "npm run typecheck && npm run lint && npm run check:boundaries && npm run check:secrets && npm run test",
    "email:dev": "email dev --dir src/emails --port 3005",
    "email:export": "email export --dir src/emails --outDir out/emails",
    "export": "gulp exportTemplates",
    "export:clean": "gulp clean",
    "export:build": "gulp build",
    "export:template": "npx tsx scripts/export-templates.ts",
    "seed:templates": "npx tsx scripts/seed-templates.ts",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/generative-ai": "^0.21.0",
    "@react-email/components": "1.0.12",
    "@react-email/render": "1.4.0",
    "@uiw/react-codemirror": "^4.25.11",
    "@vercel/blob": "^2.8.0",
    "acorn": "^8.18.0",
    "acorn-jsx": "^5.3.2",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "next": "^14.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-email": "6.5.0",
    "resend": "^6.16.0",
    "sharp": "^0.33.5",
    "zod": "^3.23.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/acorn": "^4.0.6",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.0",
    "gulp": "^5.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  }
}
