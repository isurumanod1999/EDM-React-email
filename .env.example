# Copy to `.env.local` and fill in values. Never commit `.env.local`.

# ── Deployment posture (Epic 1–2 baseline) ──────────────────────────────────
# open = internal dev team, no login. enforced = requires auth (Epic F4, not wired yet).
AUTH_MODE=open

# Bind address checked at startup (Story 2.7). Use localhost for internal use.
HOST=localhost

# Template and asset storage drivers (filesystem/local only in current phase).
STORAGE_DRIVER=filesystem
ASSET_DRIVER=local

# Legacy static demo routes (/preview/*, /api/email/[template]).
# Defaults: true in development, false in production.
# ENABLE_LEGACY_DEMOS=true

# Public URL for absolute image links in sent test emails.
# Defaults to http://localhost:3000 when unset or blank.
# PUBLIC_BASE_URL=http://localhost:3000
# NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Figma import ────────────────────────────────────────────────────────────
# Required for Fetch from Figma / Build from Figma in the builder.
# FIGMA_ACCESS_TOKEN=figd_...

# FIGMA_DEBUG=true

# ── AI (screenshot import, optional Figma assist) ─────────────────────────
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_VISION_MODEL=llava:latest

# Or use Gemini instead of Ollama:
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# ── Test email send (Resend) ────────────────────────────────────────────────
# RESEND_API_KEY is required only for the builder "Send email" action.
# RESEND_API_KEY=re_...
# RESEND_FROM is optional; blank uses onboarding@resend.dev at send time.
# RESEND_FROM=onboarding@resend.dev
# Optional default recipient for the builder "Send test email" modal (client-side).
# NEXT_PUBLIC_TEST_EMAIL_DEFAULT=you@example.com
