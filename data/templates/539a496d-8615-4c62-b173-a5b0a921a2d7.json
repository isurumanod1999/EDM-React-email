                "color": "#ffffff",
                "fontSize": "18px",
                "fontWeight": 400,
                "textAlign": "center",
                "fontFamily": "\"Verdana\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
                "margin": 0,
                "padding": 0,
                "lineHeight": "28px",
                "whiteSpace": "pre-line",
                "marginBottom": 16
              },
              "mobileStyle": {
                "fontSize": "8px",
                "lineHeight": "16px"
              }
            },
            {
              "type": "Text",
              "content": "To stay eligible, all logbook services must be:",
              "style": {
                "color": "#ffffff",
                "fontSize": "18px",
                "fontWeight": 400,
                "textAlign": "center",
                "fontFamily": "\"Verdana\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
                "margin": 0,
                "padding": 0,
                "lineHeight": "28px",
                "whiteSpace": "pre-line",
                "marginBottom": 16
              }
            },
            {
              "type": "Text",
              "content": "completed within the Nissan Authorised Dealer Network; and",
              "style": {
                "color": "#ffffff",
                "fontSize": "18px",
                "fontWeight": 400,
                "textAlign": "center",
                "fontFamily": "\"Verdana\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
                "margin": 0,
                "padding": 0,
                "lineHeight": "28px",
                "whiteSpace": "pre-line",
                "marginBottom": 16
              }
            },
            {
              "type": "Text",
              "content": "carried out in line with the scheduled service intervals in your Nissan Warranty & Maintenance booklet; and",
              "style": {
                "color": "#ffffff",
                "fontSize": "18px",
                "fontWeight": 400,
                "textAlign": "center",
                "fontFamily": "\"Verdana\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
                "margin": 0,
                "padding": 0,
                "lineHeight": "28px",
                "whiteSpace": "pre-line",
                "marginBottom": 16
              }
            },
            {
              "type": "Text",
              "content": "within 60 calendar days or 3,000km of the applicable scheduled service interval.",
              "style": {
                "color": "#ffffff",
                "fontSize": "18px",
                "fontWeight": 400,
                "textAlign": "center",
                "fontFamily": "\"Verdana\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
                "margin": 0,
                "padding": 0,
                "lineHeight": "28px",
