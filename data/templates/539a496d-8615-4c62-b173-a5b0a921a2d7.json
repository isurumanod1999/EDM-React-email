    {
      "id": "fa843038-0b4c-4aaa-91e5-bba5ef4a99c8",
      "componentId": "figma-react-email",
      "componentVersion": 1,
      "props": {
        "tree": {
          "type": "Section",
          "style": {
            "maxWidth": 600,
            "width": "100%",
            "margin": "0 auto",
            "backgroundColor": "#29333E",
            "textAlign": "left"
          },
          "children": [
            {
              "type": "Section",
              "style": {
                "width": "100%",
                "textAlign": "left",
                "paddingTop": 0,
                "paddingRight": 40,
                "paddingBottom": 0,
                "paddingLeft": 40,
                "backgroundColor": "#29333E"
              },
              "children": [
                {
                  "type": "Section",
                  "style": {
                    "width": "100%",
                    "textAlign": "left",
                    "border": "1px solid #4b566f",
                    "padding": "32px 0px 32px 0px"
                  },
                  "children": [
                    {
                      "type": "Text",
                      "content": "*Up to a maximum of 10 years or 300,000km, whichever occurs first, when servicing at authorised Nissan dealers. Where vehicle is not serviced through Nissan or ceases to be serviced at Nissan, additional years will not be added so 10 year/300,000km warranty (whichever occurs first) may not apply. Warranty protection will remain 5 year/150,000km warranty (whichever occurs first), plus any additional service activated years added under the Plan. Conditions apply. Lithium-Ion battery pack warranted against battery capacity loss below 9 bars out of 12 (as shown in vehicle capacity gauge), for a period of 8 years or 160,000 kilometres, whichever occurs first. Full terms at Nissan.co.nz/warranty.",
                      "style": {
                        "color": "#ffffff",
                        "fontSize": "10px",
                        "fontWeight": 400,
                        "textAlign": "left",
                        "fontFamily": "\"Verdana\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
                        "margin": 0,
                        "padding": 0,
                        "lineHeight": "14px",
                        "letterSpacing": "0.25px",
                        "whiteSpace": "pre-line",
                        "marginBottom": 8
                      }
                    },
                    {
                      "type": "Text",
                      "content": "**Ask your Nissan Dealer to explain exactly what items are covered in each Scheduled Service. Applies for the first 5 services or 5 years, whichever occurs first. Some exclusions apply. Ask your Nissan Dealer or view full terms at Nissan.co.nz/servicing.",
                      "style": {
                        "color": "#ffffff",
                        "fontSize": "10px",
                        "fontWeight": 400,
                        "textAlign": "left",
                        "fontFamily": "\"Verdana\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
                        "margin": 0,
                        "padding": 0,
                        "lineHeight": "14px",
                        "letterSpacing": "0.25px",
                        "whiteSpace": "pre-line",
                        "marginBottom": 8
                      }
                    },
                    {
                      "type": "Text",
                      "content": "†When servicing at authorised Nissan dealers. Where vehicle is not serviced through Nissan or ceases to be serviced at Nissan, additional years will not be added, so  10 year/300,000km roadside assistance (whichever occurs first) may not apply. Roadside assistance duration will remain as 1 year unlimited kilometre roadside assistance, plus any service activated years added under the Plan. Conditions apply. View full terms here.",
                      "style": {
                        "color": "#ffffff",
                        "fontSize": "10px",
                        "fontWeight": 400,
                        "textAlign": "left",
                        "fontFamily": "\"Verdana\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
                        "margin": 0,
                        "padding": 0,
                        "lineHeight": "14px",
                        "letterSpacing": "0.25px",
                        "whiteSpace": "pre-line",
                        "marginBottom": 22
                      }
                    },
                    {
                      "type": "Text",
                      "content": "If you do not wish to receive future emails and special offers from Nissan New Zealand click here to unsubscribe.   Nissan is committed to safeguarding your personal information. View our privacy policy to find out more. To locate your Nissan Dealer simply click here.  NISSAN NEW ZEALAND LIMITED",
                      "style": {
                        "color": "#ffffff",
                        "fontSize": "10px",
                        "fontWeight": 400,
                        "textAlign": "left",
                        "fontFamily": "\"Verdana\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
                        "margin": 0,
